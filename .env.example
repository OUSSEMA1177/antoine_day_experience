# Plateforme B2B Day Experience (script scrape_b2b.py)
B2B_LOGIN=your_b2b_login
B2B_PASSWORD=your_b2b_password
B2B_AGENT=1268|Mme Day Exeprience
B2B_REQUEST_DELAY=0.6
B2B_MAX_RETRIES=5

# --- LLM (un seul actif via LLM_MODEL) ---
# Gratuit / dev
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
# LLM_MODEL=groq/llama-3.3-70b-versatile
# LLM_MODEL=gemini/gemini-2.0-flash

# Payant — recommandé pour démo / prod
ANTHROPIC_API_KEY=your_anthropic_api_key_here
LLM_MODEL=anthropic/claude-haiku-4-5
# LLM_MODEL=anthropic/claude-sonnet-4-5
# OPENAI_API_KEY=your_openai_api_key_here
# LLM_MODEL=openai/gpt-4o-mini

# Fallback optionnel (ex. haiku si sonnet en rate limit)
# LLM_FALLBACK_MODEL=anthropic/claude-haiku-4-5

# Optimisation tokens (réponses courtes, moins d'historique / catalogue injecté)
LLM_MAX_TOKENS=512
LLM_TIMEOUT=90
LLM_RETRY_MAX=1
LLM_RETRY_DELAY=2.0
LLM_HISTORY_LIMIT=8
LLM_CATALOG_INJECT_LIMIT=4
LLM_COMPACT_PROMPT=true
LLM_LOG_USAGE=true
LLM_NLU_EXTRACT=true

# Support / escalade (remboursement, litige) — e-mail hors chat
SUPPORT_EMAIL=support@day-experience-demo.com

API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:5500,http://localhost:8000
